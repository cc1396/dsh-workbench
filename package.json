{
  "name": "@local/dsh-workbench",
  "version": "2.0.4",
  "private": true,
  "description": "Developer workbench: session states and attention items, project-to-request cost attribution, metadata search, project progress and an editable evidence daily report",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "sessions.js",
    "ledger.js",
    "search.js",
    "progress.js",
    "store.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
